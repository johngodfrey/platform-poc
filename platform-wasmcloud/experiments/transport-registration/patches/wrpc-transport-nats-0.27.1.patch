+// Queueing registration is insufficient: a peer can reply before the dispatcher
+// processes that command. Wait for local routing readiness before either handshake.
+async fn register_subscriptions(
+    commands: &mpsc::Sender<Command>,
+    subscriptions: Vec<Command>,
+) -> anyhow::Result<()> {
+    let (registered, ready) = oneshot::channel();
+    commands
+        .send(Command::Batch(subscriptions.into_boxed_slice(), registered))
+        .await
+        .context("failed to queue subscription registration")?;
+    ready.await.context("subscription dispatcher stopped before registration")
 }
 
