    {
      "id": 12,
      "title": "Application CPU-seconds / 1,000 accepted orders",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "footprint-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(poc_app_cpu_cores / on (implementation) group_right () (sum by (implementation,testid) (rate(k6_demo_orders_accepted_total{testid=~\"$run\",implementation=~\"$implementation\",testid=~\"density-.*\"}[30s])) > 0) * 1000) and on (implementation,testid) (max by (implementation,testid) (min_over_time(k6_demo_phase{testid=~\"$run\",implementation=~\"$implementation\",testid=~\"density-.*\"}[30s])) == 1) and on (implementation,testid) (max by (implementation,testid) (max_over_time(k6_demo_phase{testid=~\"$run\",implementation=~\"$implementation\",testid=~\"density-.*\"}[30s])) == 1)",
          "legendFormat": "{{implementation}} {{testid}}",
          "datasource": {
            "type": "prometheus",
            "uid": "footprint-prometheus"
          }
        }
      ],
      "description": "Run-specific live ratio, not cumulative CPU cost. Both CPU and throughput use 30-second windows. Only shown after a full window in the load phase; startup and recovery are excluded to avoid dividing lingering CPU usage by nearly zero throughput. Includes application idle/background CPU; run one test per implementation at a time.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
