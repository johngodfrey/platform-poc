{
  "uid": "java-wasm-memory-density",
  "title": "Java vs Wasm \u2014 memory density",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "platform-poc",
    "memory-density"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Application memory \u2014 current",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "footprint-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "poc_app_memory_bytes",
          "legendFormat": "{{implementation}}",
          "datasource": {
            "type": "prometheus",
            "uid": "footprint-prometheus"
          }
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^java.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^wasm.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
