{
  "uid": "java-wasm-autoscale",
  "title": "Java vs Wasm \u2014 automatic scaling",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "platform-poc",
    "autoscale"
  ],
  "panels": [
    {
      "id": 1,
      "title": "CPU signal and target per capacity unit",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "footprint-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k6_autoscale_cpu_cores{testid=~\"$run\",implementation=~\"$implementation\",testid=~\"autoscale-.*\"}",
          "legendFormat": "{{implementation}} total CPU",
          "datasource": {
            "type": "prometheus",
            "uid": "footprint-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "k6_autoscale_target_cpu_cores{testid=~\"$run\",implementation=~\"$implementation\",testid=~\"autoscale-.*\"}",
          "legendFormat": "{{implementation}} target/unit",
          "datasource": {
            "type": "prometheus",
            "uid": "footprint-prometheus"
          }
        }
      ],
      "description": "60-second CPU rates. Java order-service CPU versus Wasm runtime CPU; targets are independently calibrated. Divide total CPU by serving capacity for downscale decisions.",
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^java.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^wasm.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
