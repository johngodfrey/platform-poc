{
  "uid": "java-wasm-scaleout",
  "title": "Java vs Wasm \u2014 scale-out",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "platform-poc",
    "scaleout"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Application memory",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "footprint-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "poc_app_memory_bytes",
          "legendFormat": "{{implementation}}",
          "datasource": {
            "type": "prometheus",
            "uid": "footprint-prometheus"
          }
        }
      ],
      "description": "Live deployment working sets; aggregate telemetry has shown inconsistencies after restarts. Run selection does not filter resource charts.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^java.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^wasm.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#73BF69"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
